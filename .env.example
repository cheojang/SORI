# ===== 바른발음 환경 변수 설정 =====
# 이 파일을 복사하여 .env.local 파일을 만들고 실제 값을 입력하세요
# cp .env.example .env.local

# ---- Database ----
# PostgreSQL 연결 문자열 (Supabase / Neon / Railway 등)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/bareunbareum?schema=public"

# ---- NextAuth ----
# 랜덤 비밀키 생성: openssl rand -base64 32
AUTH_SECRET="your-random-secret-key"
# 로컬: http://localhost:3000 / 프로덕션: https://yourdomain.com
NEXTAUTH_URL="http://localhost:3000"

# ---- Google OAuth ----
# https://console.cloud.google.com/apis/credentials 에서 생성
# 승인된 리디렉션 URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ---- Kakao OAuth ----
# https://developers.kakao.com/ 에서 앱 생성
# 카카오 로그인 → Redirect URI: {NEXTAUTH_URL}/api/auth/callback/kakao
KAKAO_CLIENT_ID="your-kakao-rest-api-key"
KAKAO_CLIENT_SECRET="your-kakao-client-secret"

# ---- Gemini AI ----
# https://aistudio.google.com/app/apikey 에서 발급
GEMINI_API_KEY="your-gemini-api-key"

# ---- 포트원(PortOne) 정기결제 ----
# 포트원 콘솔(admin.portone.io)에서 확인/발급.
# PG사(NHN KCP 등)는 채널키로 지정되므로, PG를 바꿔도 코드 수정 없이 채널키만 교체하면 된다.
#
#  상점 ID   : 콘솔 > 결제연동 > 식별코드·API Keys  (store-로 시작)
#  채널 키   : 콘솔 > 결제연동 > 채널 관리에서 생성한 채널 (channel-key-로 시작)
#  API Secret: 콘솔 > 결제연동 > API Keys > V2 API Secret  (서버 전용, 절대 노출 금지)
#  웹훅 시크릿: 콘솔 > 결제연동 > 웹훅 설정에서 발급
NEXT_PUBLIC_PORTONE_STORE_ID="store-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
NEXT_PUBLIC_PORTONE_CHANNEL_KEY="channel-key-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
PORTONE_STORE_ID="store-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
PORTONE_API_SECRET="your-v2-api-secret"
PORTONE_WEBHOOK_SECRET="your-webhook-secret"

# 플레이스토어(TWA) 안에서 구독 버튼 노출 여부. "true"가 아니면 기본적으로 숨김(안전 기본값).
# 구글 플레이 심사 제출 시엔 비워두거나 false로 → 인앱결제 우회로 보이지 않게.
# 심사 통과 후 "true"로 바꿔 재배포하면 앱 재심사 없이 노출됨 (TWA는 웹 배포만으로 반영).
NEXT_PUBLIC_TWA_PAYMENT_ENABLED="false"

# ---- Resend (이메일 인증) ----
# https://resend.com/api-keys 에서 발급
RESEND_API_KEY="re_your_resend_api_key"
# 발신자 주소 (Resend에서 인증된 도메인 필요)
RESEND_FROM="바른발음 <noreply@yourdomain.com>"

# ---- 관리자 (선택) ----
# 쉼표로 구분된 관리자 이메일 목록
ADMIN_EMAILS="admin@yourdomain.com"

# ---- 개발자 로그인 (선택, 로컬 전용) ----
# 두 변수 모두 1로 설정해야 /login에서 테스트 계정 버튼이 활성화됨.
# 프로덕션에는 절대 1로 설정하지 말 것.
ALLOW_DEV_LOGIN="0"
NEXT_PUBLIC_ALLOW_DEV_LOGIN="0"

# ---- Supabase Storage (아이 사진 저장 + TTS 음성 캐시) ----
# https://supabase.com/dashboard → 프로젝트 Settings → API 에서 확인
# URL: Project URL (예: https://xxxx.supabase.co)
SUPABASE_URL="https://your-project-id.supabase.co"
# Service Role Key: 비공개 — 서버사이드 전용, 절대 클라이언트에 노출 금지
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---- Google Cloud Text-to-Speech ----
# https://console.cloud.google.com → API 및 서비스 → 라이브러리
# → "Cloud Text-to-Speech API" 검색 후 사용 설정
# → 사용자 인증 정보 → API 키 만들기
# 무료 한도: Neural2/Chirp3 HD 월 100만 자
GOOGLE_TTS_API_KEY="your-google-tts-api-key"
